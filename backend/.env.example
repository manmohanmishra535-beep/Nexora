# --- required ---------------------------------------------------------------
PORT=5000
MONGODB_URI=mongodb://localhost:27017/nexora
# DNS resolvers for the MongoDB SRV lookup when the local stub resolver fails
# (see docs/ALIGNMENT.md, "Local environment notes"). Defaults to 8.8.8.8,1.1.1.1.
# DNS_SERVERS=8.8.8.8,1.1.1.1
CLIENT_URL=http://localhost:3000
CLERK_SECRET_KEY=sk_test_...
CLERK_PUBLISHABLE_KEY=pk_test_...
# Milliseconds of clock drift tolerated when verifying Clerk tokens.
CLERK_CLOCK_SKEW_MS=30000

# --- image uploads ----------------------------------------------------------
# Optional in local dev: when these are missing or rejected, images are
# stored on local disk (backend/uploads/) and served at /uploads.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
# Public origin used in locally stored image URLs (default: http://localhost:PORT).
# API_URL=http://localhost:5000

NODE_ENV=development
